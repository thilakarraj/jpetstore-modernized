# Backend API (FastAPI)
# When using the Vite dev proxy (optional), set VITE_USE_DEV_PROXY=true and leave base URL empty.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: proxy /api to FastAPI during `npm run dev` (same-origin requests; do not also use an absolute base URL)
# VITE_USE_DEV_PROXY=false
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Mock fixtures: set true ONLY for offline UI demos. Full-stack integration must be false.
VITE_USE_MOCK_API=false
