# Application

APP_ENV=development

APP_HOST=127.0.0.1

APP_PORT=8000



# Database (local MySQL 8 — URL-encode special characters in the password, e.g. ! as %21; do not commit .env)

# Database: jpetstore | User: jpetstore_app | utf8mb4 / utf8mb4_unicode_ci

DATABASE_URL=mysql+pymysql://jpetstore_app:jpetstore_app%21@127.0.0.1:3306/jpetstore?charset=utf8mb4



# Integration tests only (database name must be jpetstore_test)

TEST_DATABASE_URL=mysql+pymysql://jpetstore_app:jpetstore_app%21@127.0.0.1:3306/jpetstore_test?charset=utf8mb4



# JWT (Phase 3)

JWT_SECRET=change-me-use-at-least-32-random-bytes-in-production

JWT_ALGORITHM=HS256

JWT_ISSUER=jpetstore

JWT_AUDIENCE=jpetstore-api

JWT_EXPIRE_MINUTES=60



# Logging (Windows-friendly paths)

LOG_LEVEL=INFO

LOG_DIR=./logs

LOG_RETENTION_DAYS=30

LOG_ROTATION=midnight

LOG_JSON=true



# CORS (comma-separated origins)

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000



# Metrics (optional basic auth in production)

METRICS_PROTECT=false

METRICS_USERNAME=

METRICS_PASSWORD=



# Rate limiting (Phase 3 — in-memory; see ADR-P3-001)

RATE_LIMIT_LOGIN_PER_MINUTE=10

RATE_LIMIT_REGISTER_PER_MINUTE=10



# Catalog pagination / search (Phase 4)

CATALOG_DEFAULT_LIMIT=50

CATALOG_MAX_LIMIT=100

CATALOG_SEARCH_MAX_LENGTH=200

